# Configuration file for local development
# Copy this to .env and customize as needed

# Cache directory for API responses
CACHE_DIR=data/cache

# Default location for weather data (can be changed in UI)
DEFAULT_LOCATION=London
DEFAULT_LATITUDE=51.5074
DEFAULT_LONGITUDE=-0.1278

# Default search keyword for Google Trends (can be changed in UI)
DEFAULT_KEYWORD=umbrella

# Cache expiry in hours
CACHE_EXPIRY_HOURS=24

# Trends cache expiry in days
TRENDS_CACHE_DAYS=7

# Optional: Set to 'production' or 'development'
ENVIRONMENT=development
